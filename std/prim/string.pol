use "./char.pol"
use "../data/bool.pol"
use "../data/list.pol"

/// An opaque Unicode string.
extern String: Type

/// Concatenation of two strings.
extern concat_string(x y: String): String

infix _ ++ _ := concat_string(_, _)

/// Appending a single unicode character to a string.
extern append_char(c: Char, s: String): String

/// Converting a string into a list of characters.
extern string_to_chars(s: String): List(Char)

/// Return whether two strings are equal.
extern eq_string(x y: String): Bool
