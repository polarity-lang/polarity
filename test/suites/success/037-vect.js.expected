"use strict";
const __fs = require("node:fs");
function add_i64(x, y) {
    return BigInt.asIntN(64, x + y);
}
function sub_i64(x, y) {
    return BigInt.asIntN(64, x - y);
}
function mul_i64(x, y) {
    return BigInt.asIntN(64, x * y);
}
function div_i64(x, y) {
    return BigInt.asIntN(64, x / y);
}
function add_f64(x, y) {
    return x + y;
}
function sub_f64(x, y) {
    return x - y;
}
function mul_f64(x, y) {
    return x * y;
}
function div_f64(x, y) {
    return x / y;
}
function concat(s1, s2) {
    return s1.concat(s2);
}
function append_char(c, s) {
    return s.concat(String.fromCodePoint(c));
}
function unit() {
    return void 0;
}
function return_io(x) {
    return function () {
        return x;
    };
}
function println(s) {
    return function () {
        console.log(s);
        return void 0;
    };
}
function read_file(path) {
    return function () {
        try {
            const data = __fs.readFileSync(path, "utf8");
            return {
                tag: "Some",
                args: [data],
            };
        }
        catch (err) {
            return {
                tag: "None",
                args: [],
            };
        }
    };
}
function main() {
    return append(example1({
        tag: "Unit",
        args: []
    }), {
        tag: "S",
        args: [
            {
                tag: "S",
                args: [
                    {
                        tag: "Z",
                        args: []
                    }
                ]
            }
        ]
    }, {
        tag: "S",
        args: [
            {
                tag: "S",
                args: [
                    {
                        tag: "Z",
                        args: []
                    }
                ]
            }
        ]
    }, example1({
        tag: "Unit",
        args: []
    }));
}
function add(__self, y) {
    switch(__self.tag){
        case "Z":
            return y;
        case "S":
            const x = __self.args[0];
            return {
                tag: "S",
                args: [
                    add(x, y)
                ]
            };
    }
}
function head(__self, n) {
    switch(__self.tag){
        case "Cons":
            const n0 = __self.args[0];
            const x0 = __self.args[1];
            const xs = __self.args[2];
            return x0;
    }
}
function tail(__self, n1) {
    switch(__self.tag){
        case "Cons":
            const n2 = __self.args[0];
            const x1 = __self.args[1];
            const xs0 = __self.args[2];
            return xs0;
    }
}
function append(__self, n3, m, ys) {
    switch(__self.tag){
        case "Nil":
            return ys;
        case "Cons":
            const n4 = __self.args[0];
            const x2 = __self.args[1];
            const xs1 = __self.args[2];
            return {
                tag: "Cons",
                args: [
                    add(n4, m),
                    x2,
                    append(xs1, n4, m, ys)
                ]
            };
    }
}
function example1(__self) {
    switch(__self.tag){
        case "Unit":
            return {
                tag: "Cons",
                args: [
                    {
                        tag: "S",
                        args: [
                            {
                                tag: "Z",
                                args: []
                            }
                        ]
                    },
                    {
                        tag: "Z",
                        args: []
                    },
                    {
                        tag: "Cons",
                        args: [
                            {
                                tag: "Z",
                                args: []
                            },
                            {
                                tag: "Z",
                                args: []
                            },
                            {
                                tag: "Nil",
                                args: []
                            }
                        ]
                    }
                ]
            };
    }
}
console.log(JSON.stringify(main(), (k, v)=>typeof v == "bigint" ? v.toString() : v));
